# Opcionales. Sin valor, la web muestra "Próximamente" en vez de un enlace muerto.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# Firebase (consola de Firebase → Configuración del proyecto → Tus apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# URL de la API de Go (solo la usa el servidor de Next para reenviar /api/*)
API_URL=http://localhost:8080

# --- Publicación estática en GitHub Pages (npm run build:pages) ---
# Subcarpeta donde queda el sitio: "/<nombre-del-repo>" en un sitio de proyecto; vacío con dominio propio.
NEXT_PUBLIC_BASE_PATH=
# Dirección pública de la API (en desarrollo no hace falta: Next reenvía /api/*).
NEXT_PUBLIC_API_URL=
